# Copy to apps/web/.env.local. Firebase web config values are not secret, but never commit real values.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-myai.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-myai
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-myai.appspot.com
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id
# true = talk to the local Emulator Suite instead of a real Firebase project
NEXT_PUBLIC_USE_EMULATORS=true
# Server-only secrets (the OpenAI key) live in Google Secret Manager, never in this file.
