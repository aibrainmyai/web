rules_version = '2';
// Deny by default. Apps read their own data and change a few display fields;
// everything else (including every message) is written by Cloud Functions. PLAN section 11.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow update: if isOwner(uid)
        && onlyChanges(['displayName', 'photoURL', 'language', 'preferredModelId', 'memoryEnabled', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;
      allow create, delete: if false;   // bootstrapAccount creates, deleteAccount deletes

      match /conversations/{cid} {
        allow read: if isOwner(uid);
        allow update: if isOwner(uid) && onlyChanges(['title', 'archived', 'updatedAt']);
        allow create, delete: if false;
        match /messages/{mid} {
          allow read: if isOwner(uid);
          allow write: if false;
        }
      }
      match /attachments/{aid}     { allow read: if isOwner(uid); allow write: if false; }
      match /user_memory/{id}      { allow read, delete: if isOwner(uid); allow create, update: if false; }
      match /knowledge_documents/{did} {
        allow read: if isOwner(uid);
        allow write: if false;
        match /chunks/{chunkId} { allow read, write: if false; }
      }
      match /devices/{deviceId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['fcmToken', 'platform', 'lastSeenAt']);
      }
      match /consents/{type} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['version', 'acceptedAt']);
        allow update, delete: if false;
      }
    }

    match /subscriptions/{uid}     { allow read: if isOwner(uid); allow write: if false; }
    match /usage_records/{id}      { allow read: if signedIn() && resource.data.uid == request.auth.uid; allow write: if false; }
    match /plans/{planId}          { allow read: if signedIn(); allow write: if false; }
    match /system_settings/public  { allow read: if true; allow write: if false; }
    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if false;
    }

    match /{document=**} { allow read, write: if false; }   // everything else: closed
  }
}
